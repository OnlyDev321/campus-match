# Sao chép thành .env.local; khởi động lại Next.js sau khi thay đổi.
# API thật là mặc định. Đặt true CHỈ khi phát triển giao diện độc lập.
NEXT_PUBLIC_USE_MOCK_API=false
# URL trình duyệt gọi Spring Boot, bao gồm /api.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api
# URL BFF gọi Spring Boot, KHÔNG có /api.
SPRING_BOOT_API_URL=http://localhost:8080
