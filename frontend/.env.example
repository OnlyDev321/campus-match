# Spring Boot API URL used by the frontend REST client.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api

# Server-only secret the BFF uses to sign the SSO assertion it sends to the Spring Boot backend.
# Must be identical to the backend's SSO_ASSERTION_SECRET: at least 32 random bytes
# (e.g. `openssl rand -hex 32`). Never prefix with NEXT_PUBLIC_.
SSO_ASSERTION_SECRET=replace_with_the_same_random_secret_as_the_backend

# Spring Boot origin the BFF calls server-to-server for login (defaults to http://localhost:8080).
SPRING_BOOT_API_URL=http://localhost:8080

# FactChat API key used by the translation route.
FACTCHAT_API_KEY=replace_with_factchat_api_key

# FactChat model name.
FACTCHAT_MODEL=gpt-5.4-mini
