# Campus Match - Docker development environment.
#
# Setup (PowerShell, from the repository root):
#   Copy-Item .env.docker.example .env.docker
# then replace every <placeholder> below. .env.docker is gitignored. Never commit it.
#
# These are DEV-ONLY values for the throwaway Docker database. Do NOT reuse production credentials here
# (the real Neon values stay in the separate, untouched .env / backend environment).
#
# One way to generate a random hex value (works in Windows PowerShell 5.1 and PowerShell 7):
#   $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); -join ($b | ForEach-Object { $_.ToString('x2') })
#
# compose.yaml pins DB_URL (jdbc:postgresql://db:5432/campus_match_dev) and DB_USERNAME (postgres) itself,
# so they are not set here. Do not add them.

# --- PostgreSQL + backend -------------------------------------------------------------------------------
# Superuser password of the Docker database. It is applied only when the data volume is first created;
# changing it later does not change an existing database (see DOCKER.md, Troubleshooting).
# Use only letters and digits (hex is fine) so it is safe inside the JDBC connection settings.
DB_PASSWORD=<random-dev-database-password>

# Signs the JWTs the backend issues. At least 32 bytes of randomness.
JWT_SECRET=<random-hex-at-least-64-characters>

# --- SSO bridge: Next.js BFF -> backend (POST /api/auth/sso/usaint) -------------------------------------
# One value shared by the backend (verifies) and the frontend server (signs). Server-side only: never
# prefix it with NEXT_PUBLIC_. At least 32 bytes and DIFFERENT from JWT_SECRET (the backend refuses to
# start otherwise). If it is missing, the endpoint rejects every request (fail closed).
SSO_ASSERTION_SECRET=<different-random-hex-at-least-64-characters>

# --- Optional: group translation (frontend server only) -------------------------------------------------
# Leave FACTCHAT_API_KEY empty to run without translation (POST /api/translate answers 503).
FACTCHAT_API_KEY=
FACTCHAT_MODEL=gpt-5.4-mini
