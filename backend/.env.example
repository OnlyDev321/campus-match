DB_URL=jdbc:postgresql://your-neon-host/your-database?sslmode=require
DB_USERNAME=your_database_username
DB_PASSWORD=your_database_password
JWT_SECRET=replace_with_a_long_random_secret
# Shared with the Next.js BFF (same value in frontend SSO_ASSERTION_SECRET). Server-side only.
# At least 32 random bytes, e.g. `openssl rand -hex 32`, and DIFFERENT from JWT_SECRET.
# If unset, POST /api/auth/sso/usaint rejects every request (fail closed).
SSO_ASSERTION_SECRET=replace_with_a_different_random_secret_of_at_least_32_bytes
